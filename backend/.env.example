# ===== 后端配置模板 =====
# 使用方法：复制本文件为 backend/.env（Windows: copy .env.example .env），再把下面的值改成你自己的。
# backend/.env 已被 .gitignore 忽略，不会上传到 GitHub。

# ----- 数据库（MySQL 5.7）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=clothes_sort_mysql

# ----- JWT 登录令牌签名密钥 -----
# 必须改成你自己的随机长字符串。使用默认值或泄露都会让别人能伪造登录令牌。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ----- 腾讯云 COS（衣服图片存储）-----
# 在腾讯云控制台「访问管理 → API 密钥管理」获取
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
# 存储桶名称形如 name-1250000000（名称-APPID），地域如 ap-guangzhou
COS_BUCKET=your-bucket-name-appid
COS_REGION=ap-guangzhou
