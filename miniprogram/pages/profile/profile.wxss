.page { padding: 24rpx; box-sizing: border-box; }

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 12rpx 32rpx rgba(124, 58, 237, 0.10),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.85);
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  box-shadow:
    0 8rpx 20rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
}
.nickname { font-size: 36rpx; font-weight: 800; color: #46405A; }
.username { margin-top: 6rpx; color: #B4A7D4; }

/* 菜单 */
.menu {
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 10rpx 30rpx rgba(124, 58, 237, 0.08),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.85);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 2rpx solid #F6F2FB;
  transition: background 0.15s;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #F5F3FC; }
.menu-icon { font-size: 38rpx; margin-right: 22rpx; }
.menu-text { flex: 1; font-size: 28rpx; font-weight: 500; color: #46405A; }
.arrow { color: #DDD3EE; font-size: 40rpx; }

.logout-btn { margin-top: 44rpx; height: 88rpx; border-radius: 44rpx; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(74, 68, 88, 0.45);
  backdrop-filter: blur(4rpx);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.modal {
  width: 100%;
  padding: 40rpx 34rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(124, 58, 237, 0.20);
}
.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #46405A;
  margin-bottom: 28rpx;
  text-align: center;
}
.modal-field { margin-bottom: 22rpx; }
.modal-field .label { font-size: 24rpx; font-weight: 600; color: #9A93A8; margin-bottom: 12rpx; }
.modal-field .input {
  background: #F4F1FA;
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  box-shadow: inset 0 3rpx 8rpx rgba(124, 58, 237, 0.07);
}
.modal-actions { display: flex; gap: 22rpx; margin-top: 32rpx; }
.modal-btn { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 28rpx; }
