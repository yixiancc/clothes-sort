.page { padding: 24rpx; box-sizing: border-box; }
.block {
  padding: 36rpx 30rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 10rpx 30rpx rgba(124, 58, 237, 0.08),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.85);
}
.label { font-size: 26rpx; font-weight: 600; color: #9A93A8; margin-bottom: 16rpx; }
.input {
  background: #F4F1FA;
  border-radius: 24rpx;
  padding: 22rpx 30rpx;
  font-size: 28rpx;
  color: #46405A;
  box-shadow:
    inset 0 3rpx 8rpx rgba(124, 58, 237, 0.07),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.8);
}
.tip { margin-top: 20rpx; line-height: 1.7; color: #B4A7D4; }
.btn-row { display: flex; gap: 22rpx; margin-top: 36rpx; }
.half { flex: 1; height: 84rpx; border-radius: 42rpx; font-size: 28rpx; }
