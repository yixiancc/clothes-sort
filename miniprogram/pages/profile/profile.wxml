<view class="page">
  <view class="user-card card">
    <view class="avatar">{{avatarText}}</view>
    <view class="user-info">
      <view class="nickname">{{user.nickname || user.username}}</view>
      <view class="username muted">@{{user.username}}</view>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goStats">
      <text class="menu-icon">📊</text><text class="menu-text">数据统计</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCalendar">
      <text class="menu-icon">🗓️</text><text class="menu-text">穿着日历</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCategories">
      <text class="menu-icon">🏷️</text><text class="menu-text">分类管理</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goLocations">
      <text class="menu-icon">📍</text><text class="menu-text">位置管理</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="editProfile">
      <text class="menu-icon">👤</text><text class="menu-text">个人资料</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{user.is_admin}}" bindtap="goAdmin">
      <text class="menu-icon">🛡️</text><text class="menu-text">用户审核（管理员）</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text><text class="menu-text">服务器地址</text><text class="arrow">›</text>
    </view>
  </view>

  <button class="btn-plain logout-btn" bindtap="logout">退出登录</button>

  <!-- 个人资料弹窗 -->
  <view class="modal-mask" wx:if="{{showProfile}}" bindtap="closeProfile">
    <view class="modal card" catchtap="noop">
      <view class="modal-title">个人资料</view>
      <view class="modal-field">
        <view class="label">用户名</view>
        <input class="input" value="{{form.username}}" bindinput="onFormInput" data-field="username" maxlength="50" />
      </view>
      <view class="modal-field">
        <view class="label">昵称</view>
        <input class="input" value="{{form.nickname}}" bindinput="onFormInput" data-field="nickname" maxlength="50" />
      </view>
      <view class="modal-field">
        <view class="label">原密码（修改密码时必填）</view>
        <input class="input" password value="{{form.old_password}}" bindinput="onFormInput" data-field="old_password" />
      </view>
      <view class="modal-field">
        <view class="label">新密码（至少6位，留空则不修改）</view>
        <input class="input" password value="{{form.new_password}}" bindinput="onFormInput" data-field="new_password" />
      </view>
      <view class="modal-actions">
        <button class="btn-plain modal-btn" bindtap="closeProfile">取消</button>
        <button class="btn-primary modal-btn" bindtap="saveProfile" disabled="{{saving}}">保存</button>
      </view>
    </view>
  </view>
</view>
