.page { padding: 0 24rpx 40rpx; box-sizing: border-box; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 4rpx 18rpx; }
.topbar-title { font-size: 32rpx; font-weight: 800; color: #46405A; }
.topbar-title .muted { margin-left: 10rpx; font-weight: 400; }
.new-btn {
  padding: 16rpx 30rpx; border-radius: 40rpx; font-size: 26rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 3rpx rgba(255,255,255,0.3);
}
.new-btn:active { transform: scale(0.95); }

.outfit { padding: 26rpx; margin-bottom: 22rpx; }
.o-head { display: flex; align-items: baseline; justify-content: space-between; }
.o-name { font-size: 32rpx; font-weight: 800; color: #46405A; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.thumbs { display: flex; gap: 14rpx; margin-top: 20rpx; }
.thumb { width: 150rpx; height: 190rpx; border-radius: 22rpx; flex: none; background: linear-gradient(135deg, #F4F2FA, #EDE9FE); }
.thumb.more { display: flex; align-items: center; justify-content: center; color: #7C3AED; font-weight: 700; font-size: 30rpx; background: #EDE9FE; }
.o-note { margin-top: 16rpx; }
.o-wear { margin-top: 14rpx; font-size: 24rpx; color: #B4A7D4; }
.o-wear.worn { color: #7C3AED; font-weight: 600; }
.o-actions { display: flex; gap: 12rpx; margin-top: 20rpx; border-top: 2rpx solid #F4F1FB; padding-top: 20rpx; }
.action-btn {
  flex: 1; text-align: center; font-size: 24rpx; font-weight: 600; color: #7C3AED; padding: 14rpx 0;
  border-radius: 28rpx; background: linear-gradient(135deg, #EDE9FE, #DDD6FE); white-space: nowrap;
}
.action-btn.wear { flex: 2; }
.action-btn.wear.done { color: #fff; background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
.action-btn.danger { color: #E11D48; background: linear-gradient(135deg, #FFE4E6, #FECDD3); }
.action-btn:active { transform: scale(0.94); }
.empty { padding: 160rpx 0; }
.empty-sub { font-size: 24rpx; margin-top: 14rpx; color: #C4B5E0; }
