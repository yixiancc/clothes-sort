<view class="page">
  <view class="card block">
    <view class="label">搭配名称</view>
    <input class="input" placeholder="如：周一通勤" value="{{name}}" bindinput="onInput" data-field="name" maxlength="50" />
    <view class="label">备注（可选）</view>
    <input class="input" placeholder="场合、心情……" value="{{note}}" bindinput="onInput" data-field="note" maxlength="200" />
  </view>

  <view class="card block">
    <view class="label">已选 {{selectedIds.length}}/{{maxItems}} 件<text class="muted">（点缩略图可移到最前，点 × 移除）</text></view>
    <view class="sel-row" wx:if="{{selected.length > 0}}">
      <view class="sel-item" wx:for="{{selected}}" wx:key="id">
        <image class="sel-img" src="{{item.image_url}}" mode="aspectFill" bindtap="moveFirst" data-id="{{item.id}}" />
        <view class="sel-x" bindtap="remove" data-id="{{item.id}}">×</view>
        <view class="sel-no">{{index + 1}}</view>
      </view>
    </view>
    <view class="muted" wx:else>从下面的衣服里挑 2~8 件</view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索衣服名称" value="{{keyword}}" confirm-type="search"
           bindinput="onInput" data-field="keyword" bindconfirm="onSearch" />
  </view>

  <view class="grid">
    <view class="pick {{selectedMap[item.id] ? 'on' : ''}}" wx:for="{{clothes}}" wx:key="id" bindtap="toggle" data-id="{{item.id}}">
      <image class="pick-img" src="{{item.image_url}}" mode="aspectFill" lazy-load />
      <view class="pick-name">{{item.name}}</view>
      <view class="pick-badge" wx:if="{{selectedMap[item.id]}}">{{selectedMap[item.id]}}</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && clothes.length === 0}}">没有找到衣服</view>
  <view class="loading-more muted" wx:if="{{loading}}">加载中...</view>

  <view class="bottom-gap"></view>
  <view class="save-bar">
    <button class="btn-primary save-btn" bindtap="save" disabled="{{saving}}">{{saving ? '保存中...' : '保 存'}}</button>
  </view>
</view>
