.page { padding: 20rpx 24rpx 0; box-sizing: border-box; }
.block { padding: 26rpx; margin-bottom: 20rpx; }
.label { font-size: 26rpx; font-weight: 700; color: #46405A; margin: 6rpx 0 14rpx; }
.label .muted { margin-left: 10rpx; font-weight: 400; }
.block .input { margin-bottom: 14rpx; }

.sel-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sel-item { position: relative; width: 150rpx; height: 190rpx; }
.sel-img { width: 150rpx; height: 190rpx; border-radius: 22rpx; background: #EDE9FE; }
.sel-x {
  position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #E11D48; color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(225, 29, 72, 0.35);
}
.sel-no {
  position: absolute; left: 8rpx; bottom: 8rpx; min-width: 36rpx; height: 36rpx; padding: 0 8rpx; box-sizing: border-box;
  border-radius: 18rpx; background: rgba(124, 58, 237, 0.9); color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

.search-bar { padding: 6rpx 0 16rpx; }
.search-input {
  background: #fff; border-radius: 40rpx; padding: 20rpx 34rpx; font-size: 28rpx; color: #46405A;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.08);
}

.grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.pick { position: relative; border-radius: 24rpx; overflow: hidden; background: #fff; border: 4rpx solid transparent; box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.08); }
.pick.on { border-color: #7C3AED; }
.pick-img { width: 100%; height: 250rpx; display: block; background: #EDE9FE; }
.pick-name { padding: 10rpx 12rpx 12rpx; font-size: 22rpx; color: #46405A; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pick-badge {
  position: absolute; top: 10rpx; right: 10rpx; min-width: 40rpx; height: 40rpx; padding: 0 8rpx; box-sizing: border-box;
  border-radius: 20rpx; background: linear-gradient(135deg, #8B5CF6, #7C3AED); color: #fff; font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.empty { padding: 80rpx 0; }
.loading-more { text-align: center; padding: 24rpx 0; }
.bottom-gap { height: 170rpx; }
.save-bar {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(244, 242, 250, 0.96); box-sizing: border-box;
}
.save-btn { height: 88rpx; border-radius: 44rpx; }
