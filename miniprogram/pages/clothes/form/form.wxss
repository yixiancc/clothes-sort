.page { padding: 24rpx; box-sizing: border-box; }

/* 图片选择区 */
.img-area {
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 3rpx dashed #C4B5FD;
  box-shadow:
    0 10rpx 26rpx rgba(124, 58, 237, 0.08),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.85);
  transition: transform 0.2s;
}
.img-area:active { transform: scale(0.98); }
.preview-img { width: 100%; height: 100%; border-radius: 30rpx; }
.img-placeholder { text-align: center; color: #C4B5E0; }
.plus {
  font-size: 84rpx;
  color: #C4B5FD;
  line-height: 1;
  font-weight: 300;
}

.form-block {
  padding: 32rpx 30rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 10rpx 30rpx rgba(124, 58, 237, 0.08),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.85);
}
.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #9A93A8;
  margin: 28rpx 0 14rpx;
}
.label:first-child { margin-top: 0; }

.input {
  background: #F4F2FA;
  border-radius: 24rpx;
  padding: 22rpx 30rpx;
  font-size: 28rpx;
  box-shadow:
    inset 0 3rpx 8rpx rgba(124, 58, 237, 0.07),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.picker-row { display: flex; align-items: center; gap: 16rpx; }
.picker {
  flex: 1;
  background: #F4F2FA;
  border-radius: 24rpx;
  padding: 22rpx 30rpx;
  font-size: 28rpx;
  color: #46405A;
  box-shadow:
    inset 0 3rpx 8rpx rgba(124, 58, 237, 0.07),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.8);
}
.picker-add {
  padding: 20rpx 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  border-radius: 24rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.30);
  transition: transform 0.15s;
}
.picker-add:active { transform: scale(0.94); }

/* 季节选择 */
.season-row { display: flex; gap: 18rpx; }
.season-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #fff;
  color: #9A93A8;
  border: 2rpx solid #EAE6F5;
  box-shadow: 0 4rpx 10rpx rgba(124, 58, 237, 0.06);
  transition: all 0.2s;
}
.season-chip.active {
  background: linear-gradient(135deg, #8B5CF6, #7C3AED) !important;
  border-color: transparent !important;
  color: #fff !important;
  font-weight: 700;
  box-shadow:
    0 6rpx 16rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.30);
}

.save-btn { margin-top: 44rpx; height: 92rpx; border-radius: 46rpx; font-size: 32rpx; }
