.page { padding: 20rpx 24rpx 40rpx; box-sizing: border-box; }
.cal { padding: 24rpx 20rpx 28rpx; margin-bottom: 20rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; padding: 0 10rpx; }
.cal-title { font-size: 32rpx; font-weight: 800; color: #46405A; }
.nav { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F4F1FB; color: #7C3AED; font-size: 40rpx; display: flex; align-items: center; justify-content: center; }
.nav:active { background: #EDE9FE; }
.cal-sub { text-align: center; margin: 8rpx 0 18rpx; }

.week-row { display: grid; grid-template-columns: repeat(7, 1fr); }
.week { text-align: center; font-size: 22rpx; color: #B4A7D4; padding: 8rpx 0; }
.grid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: 6rpx; }
.grid.dim { opacity: 0.55; }
.cell { height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 22rpx; margin: 0 4rpx; }
.cell.sel { background: #EDE9FE; }
.cell.future .day { color: #D6CFE6; }
.day { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; font-size: 26rpx; color: #46405A; border-radius: 50%; }
.day.today { background: linear-gradient(135deg, #8B5CF6, #7C3AED); color: #fff; font-weight: 700; }
.dot { margin-top: 2rpx; min-width: 30rpx; height: 26rpx; line-height: 26rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 13rpx; background: #7C3AED; color: #fff; font-size: 18rpx; text-align: center; }

.detail { padding: 26rpx; }
.h { font-size: 28rpx; font-weight: 800; color: #46405A; margin-bottom: 14rpx; }
.h .muted { margin-left: 8rpx; font-weight: 400; }
.row { display: flex; align-items: center; padding: 12rpx 0; }
.row-img { width: 88rpx; height: 110rpx; border-radius: 16rpx; flex: none; background: #EDE9FE; }
.row-main { flex: 1; margin: 0 20rpx; min-width: 0; }
.row-name { font-size: 27rpx; color: #46405A; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.row-tag { margin-top: 6rpx; font-size: 22rpx; color: #7C3AED; }
.row-undo { flex: none; padding: 10rpx 22rpx; border-radius: 24rpx; font-size: 22rpx; color: #E11D48; background: linear-gradient(135deg, #FFE4E6, #FECDD3); }
.empty-day { text-align: center; padding: 30rpx 0 10rpx; color: #B4A7D4; font-size: 24rpx; }
