<view class="login-page">
  <view class="logo-area">
    <view class="logo">👗</view>
    <view class="app-name">我的衣柜</view>
    <view class="app-desc">记录每一件心爱的衣服</view>
  </view>

  <view class="card form-card">
    <view class="tabs">
      <view class="tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">登录</view>
      <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">注册</view>
    </view>

    <view class="field">
      <input class="input" placeholder="用户名" value="{{username}}" bindinput="onInput" data-field="username" maxlength="50" />
    </view>
    <view class="field">
      <input class="input" placeholder="密码（至少6位）" password value="{{password}}" bindinput="onInput" data-field="password" />
    </view>
    <view class="field" wx:if="{{mode === 'register'}}">
      <input class="input" placeholder="昵称（选填）" value="{{nickname}}" bindinput="onInput" data-field="nickname" maxlength="50" />
    </view>

    <view class="field captcha-row" wx:if="{{mode === 'register'}}">
      <input class="input captcha-input" placeholder="验证码" value="{{captchaCode}}" bindinput="onInput" data-field="captchaCode" maxlength="4" />
      <image class="captcha-img" src="{{captchaImage}}" bindtap="refreshCaptcha" mode="aspectFit" />
    </view>

    <view class="remember-row" wx:if="{{mode === 'login'}}" bindtap="toggleRemember">
      <view class="checkbox {{remember ? 'checked' : ''}}">{{remember ? '✓' : ''}}</view>
      <text class="remember-text">记住账号密码</text>
    </view>

    <button class="btn-primary submit-btn" bindtap="submit" disabled="{{loading}}">
      {{loading ? '请稍候...' : (mode === 'login' ? '登 录' : '注 册')}}
    </button>

    <view class="tip" wx:if="{{mode === 'register'}}">注册后需等待管理员审核通过才能登录</view>
  </view>
</view>
