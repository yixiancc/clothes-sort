.login-page {
  min-height: 100vh;
  /* 软糖渐变底：薰衣草 → 淡紫，清爽不甜腻 */
  background: linear-gradient(160deg, #DDD6FE 0%, #EDE9FE 40%, #F4F2FA 100%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.logo-area {
  text-align: center;
  padding: 150rpx 0 56rpx;
  position: relative;
}
.logo {
  font-size: 110rpx;
  display: inline-block;
  filter: drop-shadow(0 6rpx 16rpx rgba(124, 58, 237, 0.28));
  animation: bob 3s ease-in-out infinite;
}
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}
.app-name {
  font-size: 46rpx;
  font-weight: 800;
  color: #7C3AED;
  margin-top: 20rpx;
  letter-spacing: 2rpx;
}
.app-desc {
  font-size: 24rpx;
  color: #A89BC8;
  margin-top: 10rpx;
}

.form-card {
  padding: 44rpx 38rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow:
    0 16rpx 40rpx rgba(124, 58, 237, 0.14),
    0 4rpx 12rpx rgba(124, 58, 237, 0.06),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.9);
}

/* Tab 切换 */
.tabs {
  display: flex;
  margin-bottom: 40rpx;
  background: #F4F2FA;
  border-radius: 32rpx;
  padding: 8rpx;
  box-shadow: inset 0 3rpx 6rpx rgba(124, 58, 237, 0.06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #9A93A8;
  border-radius: 26rpx;
  transition: all 0.25s;
  font-weight: 500;
}
.tab.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  box-shadow:
    0 6rpx 16rpx rgba(124, 58, 237, 0.32),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.30);
}

.field { margin-bottom: 28rpx; }
.input {
  background: #F4F2FA;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  box-shadow:
    inset 0 3rpx 8rpx rgba(124, 58, 237, 0.07),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.captcha-row { display: flex; align-items: center; gap: 20rpx; }
.captcha-input { flex: 1; }
.captcha-img {
  width: 180rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #F4F2FA;
  box-shadow:
    0 4rpx 10rpx rgba(124, 58, 237, 0.10),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.7);
}

/* 记住密码：软糖复选框（紫） */
.remember-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 6rpx 0 30rpx;
}
.checkbox {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  border: 3rpx solid #C4B5FD;
  background: #fff;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 2rpx rgba(255,255,255,0.6);
  transition: all 0.2s;
}
.checkbox.checked {
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  border-color: transparent;
  box-shadow: 0 4rpx 10rpx rgba(124, 58, 237, 0.35);
}
.remember-text { font-size: 26rpx; color: #9A93A8; }

.submit-btn { margin-top: 10rpx; height: 92rpx; border-radius: 46rpx; font-size: 32rpx; }

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #B4A7D4;
  margin-top: 26rpx;
}
